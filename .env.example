SECRET_KEY=change-me
DATABASE_URL=sqlite:///kangaroo.db
OPENAI_API_KEY=

# Cascade OTP (primary login)
OTP_API_BASE_URL=https://cascade.kz/api
OTP_API_TOKEN=
OTP_PROVIDER=cascade
# Optional: whatsapp | telegram | sms (empty = cabinet default)
OTP_CHANNEL=
OTP_PURPOSE_LOGIN=login

# Admin panel phone (digits only). Empty = admin login disabled.
ADMIN_PHONE=

# Demo local OTP at /login/demo — keep 0 in production
ALLOW_DEMO_LOGIN=0
# Optional universal OTP bypass for local/dev only (empty = disabled)
PROFILE_NAME_CONFIRM_CODE=

# Web Push (pywebpush). Empty = push UI/send disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@kangaroo.kz
# Cron token for GET/POST /admin/tasks/retention?token=...
TASK_TOKEN=

ASSET_VERSION=123

# Legacy / local OTP fallback
SMS_PROVIDER=mock
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_DEMO_CODE=
